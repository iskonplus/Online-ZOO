{
"compilerOptions": {
  "module": "ES2020",
  "target": "ES2020",
  "lib": ["ES2020", "DOM"],

  "sourceMap": true,
  "declaration": true,
  "declarationMap": true,

  "strict": true,
  "noImplicitAny": true,

  "noUncheckedIndexedAccess": true,
  "exactOptionalPropertyTypes": true,

  "verbatimModuleSyntax": true,
  "isolatedModules": true,
  "noUncheckedSideEffectImports": true,
  "moduleDetection": "force",
  "skipLibCheck": true,
  "types": ["node"]
}
}
